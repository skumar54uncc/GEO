# Never commit real keys. Copy to .env.local.

# Local Postgres 16 with pgvector (Postgres.app or Docker). Must be localhost.
DATABASE_URL=postgres://localhost:5432/geo
# Tests use a separate database that is wiped on every run. Must be different from DATABASE_URL.
TEST_DATABASE_URL=postgres://localhost:5432/geo_test
# Large raw payloads (HTML, screenshots) go here, named by sha256. Gitignored.
RAW_STORE_DIR=./data/raw
# Optional: folder with pg_dump / pg_restore if they are not on PATH or in Postgres.app.
PG_BIN=
# Optional: comma separated email domains allowed to sign in, e.g. charlotte.edu
ALLOWED_LOGIN_DOMAINS=

FIREWORKS_API_KEY=
# Copy the exact dated ID from the Fireworks dashboard.
# Recommended judge: DeepSeek V4 Pro. Example path (replace with dated ID):
JUDGE_MODEL=accounts/fireworks/models/deepseek-v4-pro
# Same model is fine; Kimi K3 is an alternative for the content engine.
CONTENT_MODEL=accounts/fireworks/models/deepseek-v4-pro

SERPAPI_API_KEY=

# Seed values used only when the database is first created. Afterwards credits live in
# provider_accounts and are edited on the SerpAPI screen.
SERPAPI_STARTING_BALANCE=1000
SERPAPI_PER_RUN_CAP=40
