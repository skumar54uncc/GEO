# Never commit real keys. Copy to .env.local.

# Required by the local-only passwordless development login.
APP_BIND_HOST=127.0.0.1

# Local Postgres 16 with pgvector (Postgres.app or Docker). Must be localhost.
DATABASE_URL=postgres://localhost:5432/geo
# Tests use a separate database that is wiped on every run. Must be different from DATABASE_URL.
TEST_DATABASE_URL=postgres://localhost:5432/geo_test
# Large raw payloads (HTML, screenshots) go here, named by sha256. Gitignored.
RAW_STORE_DIR=./data/raw
# Optional: folder with pg_dump / pg_restore if they are not on PATH or in Postgres.app.
PG_BIN=
# Optional: comma separated email domains allowed to sign in, e.g. charlotte.edu
ALLOWED_LOGIN_DOMAINS=

FIREWORKS_API_KEY=
# Copy the exact dated ID from the Fireworks dashboard.
# Recommended judge: DeepSeek V4 Pro. Example path (replace with dated ID):
JUDGE_MODEL=accounts/fireworks/models/deepseek-v4-pro
# Same model is fine; Kimi K3 is an alternative for the content engine.
CONTENT_MODEL=accounts/fireworks/models/deepseek-v4-pro

# --- Phase 4: prompt generation and embedding dedupe ---
# Local embeddings (Ollama-compatible). Unset: review/generate show "dedupe disabled".
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# Optional alias for Ollama host when EMBEDDING_BASE_URL is unset.
OLLAMA_HOST=

SERPAPI_API_KEY=

# --- Phase 2: onboarding and site audit ---
# Required before any crawl: a URL or mailto: for the person running crawls. It goes in the
# crawler's User-Agent so site owners can reach you, e.g. mailto:you@charlotte.edu
CRAWLER_CONTACT_URL=
# Polite rate per host (requests per minute, at most 4 in flight). robots.txt Crawl-delay lowers it.
CRAWL_REQUESTS_PER_MINUTE=30
# Discovery checks at most this many hosts (one GET of / each). Others are listed as "not checked".
DISCOVERY_MAX_HOST_CHECKS=1500
# PageSpeed Insights API key (Google Cloud console, free with quota). Unset: PageSpeed is skipped.
PAGESPEED_API_KEY=
PAGESPEED_PAGES_PER_HOST=3
# api.data.gov key for College Scorecard (free at https://api.data.gov/signup). Unset: DEMO_KEY, about 10 calls an hour.
DATA_GOV_API_KEY=
# Google Knowledge Graph Search API key. Unset: Knowledge Graph is reported as "not checked".
GOOGLE_KG_API_KEY=
# Optional model for grouping entity candidates (defaults to JUDGE_MODEL). It only groups and labels.
ENTITY_MODEL=

# --- Phase 3: engine capture ---
# A provider with a missing variable is shown on Settings > Providers and its draws are refused ("blocked").
# Model variables have no defaults. The value must match a model priced in lib/capture/pricing.ts
# (TOKEN_RATES) exactly, or the estimate is "unknown" and the cost guard refuses the call.
# Restart `npm run dev` and `npm run worker` after editing.

# DataForSEO (ChatGPT and Gemini UI, Google AI Overview, Google AI Mode, parametric series).
# API login and API password from app.dataforseo.com > API Access (not your website password).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Perplexity / Claude primaries (medium fidelity, not the UI): DataForSEO LLM Responses.
DATAFORSEO_PERPLEXITY_MODEL=sonar
# Docs examples use claude-sonnet-5; must be a model that supports web_search on DataForSEO.
DATAFORSEO_CLAUDE_MODEL=claude-sonnet-5-5
# Model per engine for the parametric (no browsing) series via LLM Responses. Use a model name from
# DataForSEO's LLM Responses docs for that engine. Unset: that parametric route is refused.
DATAFORSEO_PARAMETRIC_MODEL_CHATGPT=
DATAFORSEO_PARAMETRIC_MODEL_CLAUDE=
DATAFORSEO_PARAMETRIC_MODEL_GEMINI=
DATAFORSEO_PARAMETRIC_MODEL_PERPLEXITY=

# Bright Data (Perplexity UI). Optional; campus OneIT currently blocks brightdata.com. Not a primary route.
BRIGHTDATA_API_KEY=

# Anthropic (Claude calibration / fallback only — primary Claude is DataForSEO above).
# Not required for the Phase 3 dry-run. Key from console.anthropic.com > API keys.
ANTHROPIC_API_KEY=
# Priced: claude-sonnet-5-5, claude-sonnet-5, claude-opus-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=

# OpenAI (ChatGPT fallback and calibration, web search). Key from platform.openai.com > API keys.
OPENAI_API_KEY=
# Priced: gpt-6.1-sol, gpt-6-sol, gpt-6-astra, gpt-6-luna
OPENAI_SEARCH_MODEL=

# Perplexity Agent API (Perplexity fallback). Key from perplexity.ai > Settings > API.
PERPLEXITY_API_KEY=
# Priced: perplexity/sonar
PERPLEXITY_MODEL=

# Gemini API with Google Search grounding (Gemini fallback). Key from aistudio.google.com > Get API key.
GEMINI_API_KEY=
# Priced: gemini-3.8-flash
GEMINI_MODEL=

# Optional local SERP service (experimental until its parity report passes).
SERPAPI_BASE_URL=
LOCAL_SERP_PARITY_REPORT=parity-report.md

# Seed values used only when the database is first created. Afterwards credits live in
# provider_accounts and are edited on the SerpAPI screen.
SERPAPI_STARTING_BALANCE=1000
SERPAPI_PER_RUN_CAP=40

# --- Phase 4: demand adapters (fixture-only execution; missing → not connected) ---
# Official Google Trends API (alpha). Unset: SerpAPI Trends is the fallback when SERPAPI_API_KEY is set.
GOOGLE_TRENDS_API_KEY=
# Search Console property URL the web team grants (e.g. sc-domain:charlotte.edu). Unset: not connected.
GOOGLE_SEARCH_CONSOLE_PROPERTY=
# Exa web/forum discussion. Unset: not connected.
EXA_API_KEY=
